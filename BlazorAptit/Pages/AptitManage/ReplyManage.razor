@page "/AptitManage/ReplyManage"
@inherits AptitManageAuthBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System.Collections.ObjectModel;
@using BlazorAptit.Models
@using Syncfusion.Blazor.Inputs
@using System.Linq
@using System.Threading
@using Syncfusion.Blazor.Layouts
@inject BlazorAptit.Models.Dapper.IAptitRepository AptitRepository
@inject BlazorAptit.Data.AptitService Service;
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage

<div class="page-header">
    <span class="oi oi-list page-header-icon" aria-hidden="true"></span>
    <div>
        <h4>결과지관리</h4>
        <p class="page-header-sub">성향유형을 선택하면 오른쪽에서 답변 내용을 확인/수정할 수 있습니다.</p>
    </div>
</div>

<style>
    .image img {
        height: 100px;
        width: 100px;
        border-radius: 10px;
        box-shadow: inset 0 0 1px #e0e0e0, inset 0 0 14px rgba(0,0,0,0.2);
    }
</style>
<div class="col-lg-12 control-section">
    <div class="content-wrapper grid-card">
        <div class="row">
            <SfSplitter CssClass="out-splitter" Height="100%" Width="100%" SeparatorSize="6">
                <SplitterPanes>
                    <SplitterPane Size="10%" Min="60px">
                        <SfGrid DataSource="@resutl">
                            <GridEvents RowSelected="RowSelecthandler" TValue="AptitReply"></GridEvents>
                            <GridTemplates>
                                <EmptyRecordTemplate>
                                    <div class="empty-state">
                                        <span class="oi oi-inbox" aria-hidden="true"></span>
                                        <p>데이터 없음</p>
                                    </div>
                                </EmptyRecordTemplate>
                            </GridTemplates>
                            <GridColumns>
                                <GridColumn Field=@nameof(AptitReply.AptitReplyID) HeaderText="문항" IsPrimaryKey="true" ValidationRules="@(new ValidationRules{ Required=true, Number=true})" TextAlign="TextAlign.Center" Width="50"></GridColumn>
                                <GridColumn Field=@nameof(AptitReply.TITLE) HeaderText="성향유형" Width="100" TextAlign="TextAlign.Center"></GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </SplitterPane>
                    <SplitterPane Size="90%" Min="60px">


                        <SfGrid DataSource="@OrderData" Query="@(new Query().Where("ID", "equal", RowIndex))" Toolbar="@(new List<string>() {"Edit","Update","Cancel"})">
                            <GridEditSettings AllowEditing="true"></GridEditSettings>
                            <GridEvents CommandClicked="OnCommandClicked" OnActionComplete="OnActionComplete" TValue="ResultContent"></GridEvents>
                            <GridTemplates>
                                <EmptyRecordTemplate>
                                    <div class="empty-state">
                                        <span class="oi oi-inbox" aria-hidden="true"></span>
                                        <p>왼쪽에서 성향유형을 선택하면 답변이 표시됩니다.</p>
                                    </div>
                                </EmptyRecordTemplate>
                            </GridTemplates>
                            <GridColumns>
                                <GridColumn Field=@nameof(ResultContent.ID) HeaderText="문항" IsIdentity="true" TextAlign="TextAlign.Left" Width="80"></GridColumn>
                                <GridColumn Field=@nameof(ResultContent.COL_NM) HeaderText="문항명" IsPrimaryKey="true" Width="140"></GridColumn>
                                <GridColumn Field=@nameof(ResultContent.VAL) HeaderText="설명"></GridColumn>
                                @*<GridColumn HeaderText="Manage Records" Width="150">
                                        <GridCommandColumns>
                                            <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Type="CommandButtonType.Save" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-save", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Type="CommandButtonType.Cancel" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-cancel-icon", CssClass="e-flat" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>*@
                            </GridColumns>
                        </SfGrid>
                    </SplitterPane>
                </SplitterPanes>
            </SfSplitter>

        </div>
    </div>
</div>

<style>
    .page-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 4px 18px;
    }

    .page-header-icon {
        font-size: 20px;
        color: #3498db;
        background: rgba(52,152,219,0.12);
        border-radius: 8px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .page-header h4 {
        margin: 0;
        font-size: 1.2em;
        font-weight: 700;
        color: #2c3e50;
    }

    .page-header-sub {
        margin: 2px 0 0;
        font-size: 12.5px;
        color: #8a94a0;
    }

    .grid-card {
        border: 1px solid #e2e6ea;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 10px;
        background: #fff;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 140px;
        color: #9aa5b1;
        text-align: center;
    }

    .empty-state .oi {
        font-size: 22px;
        margin-bottom: 8px;
        opacity: 0.6;
    }

    .empty-state p {
        font-size: 13px;
        margin: 0;
    }

    .e-grid .e-headercelldiv {
        font-size: 12px;
    }

    .e-grid .e-rowcell {
        font-size: 12px;
    }

    .e-grid .e-row:hover .e-rowcell {
        background-color: #eef4fa;
    }
</style>

