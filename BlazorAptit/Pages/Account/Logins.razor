@page "/account"
@page "/account/login"
@layout AuthLayout

@using BlazorAptit.Models.Dapper;
@using BlazorAptit.Services
@using System.Net.Http.Json;
@inject IAccountService AccountService
@inject IAlertService AlertService
@inject AptitManageAuthState AuthState

@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject NavigationManager NavigationManager
@inject IAptitRepository AptitRepository

@inject HttpClient Http;

<div class="login-page">
    <div class="login-card">
        <img class="login-logo" src="/img/LOGOIMAGE.JPG" alt="옥타그노시스" />

        <EditForm class="login-form" Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <h2 class="login-heading">관리자 로그인</h2>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="login-alert">
                    <span class="oi oi-warning" aria-hidden="true"></span> @error
                </div>
            }

            <div class="login-field">
                <span class="oi oi-person login-field-icon" aria-hidden="true"></span>
                <InputText id="inputUsername" @bind-Value="model.Username" class="form-control" placeholder="아이디" autocomplete="username" />
                <ValidationMessage For="@(() => model.Username)" />
            </div>
            <div class="login-field">
                <span class="oi oi-lock-locked login-field-icon" aria-hidden="true"></span>
                <InputText id="inputPassword" @bind-Value="model.Password" type="password" class="form-control" placeholder="패스워드" autocomplete="current-password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <button class="btn btn-primary btn-block login-submit" type="submit" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner" aria-hidden="true"></span> <span>로그인 중...</span>
                }
                else
                {
                    <span>로그인</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private Models.Account.Login model = new Models.Account.Login();
    private bool loading;
    string error { get; set; }

    private async Task OnValidSubmit()
    {
        error = null;
        loading = true;
        AlertService.Clear();

        try
        {
            var result = await AptitRepository.GetGroupMemberLoginCheck(model.Username, model.Password);

            if (result != null)
            {
                await sessionStorage.SetItemAsync("USERID", model.Username);
                AuthState.IsAuthenticated = true;
                AuthState.GroupId = model.Username;
                if (model.Username.ToLower() == "admin" )
                {
                    AuthState.IsManager = true;
                    await sessionStorage.SetItemAsync("USERROLE", "manager");
                    NavigationManager.NavigateTo($"/AptitManage/GroupList");
                }
                else
                {
                    AuthState.IsManager = false;
                    await sessionStorage.SetItemAsync("USERROLE", "user");
                    NavigationManager.NavigateTo($"/AptitManage/ResultByGroup");
                }
                return;
            }
            else
            {
                error = "아이디 또는 패스워드를 확인해주세요.";
            }
        }
        catch (Exception ex)
        {
            AlertService.Error(ex.Message);
            error = "로그인 중 오류가 발생했습니다.";
        }
        finally
        {
            loading = false;
        }
    }
}

<style>
    body {
        background: #f4f6f8 !important;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .login-card {
        width: 100%;
        max-width: 380px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.08);
        padding: 36px 32px 32px;
        text-align: center;
    }

    .login-logo {
        max-width: 180px;
        height: auto;
        margin-bottom: 8px;
    }

    .login-heading {
        font-size: 1.3em;
        font-weight: 700;
        color: #2c3e50;
        margin: 8px 0 22px;
    }

    .login-alert {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(231,76,60,0.1);
        color: #c0392b;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
        margin-bottom: 16px;
        text-align: left;
    }

    .login-field {
        position: relative;
        margin-bottom: 16px;
        text-align: left;
    }

    .login-field-icon {
        position: absolute;
        left: 12px;
        top: 12px;
        color: #9aa5b1;
        font-size: 15px;
    }

    .login-field .form-control {
        width: 100%;
        padding: 10px 12px 10px 36px;
        font-size: 15px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .login-field .form-control:focus {
        outline: none;
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52,152,219,0.15);
    }

    .login-submit {
        width: 100%;
        margin-top: 8px;
        padding: 11px;
        font-size: 15px;
        font-weight: 700;
        background-color: #3498db;
        border: none;
        border-radius: 8px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.15s ease;
    }

    .login-submit:hover:not(:disabled) {
        background-color: #2f88c4;
    }

    .login-submit:disabled {
        opacity: 0.75;
        cursor: default;
    }

    .spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.5);
        border-top-color: #fff;
        border-radius: 50%;
        display: inline-block;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
