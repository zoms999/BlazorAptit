        <div class="card-header">
            <div class="stage-title">
                <span class="stage-badge">문항 @Model.Stage</span>
                <span class="stage-type">선호도진단 Ⅲ</span>
            </div>
            <p class="stage-desc">다음은 자신의 현재와 과거의 모습을 떠올린 뒤, 좋아하는 정도를 상상해서 각각 자신에게 잘 맞는 번호를 진실하게 선택하세요.</p>
        </div>
        <ul class="list-group list-group-flush pureCSS">
            @foreach (var quest in ViewBag.quest)
            {
                <li class="list-group-item"><h5 class="font-weight-bold">@quest.QUE_19</h5></li>
                <li class="list-group-item">
                    @foreach (var item in ViewData["answer3"] as IEnumerable<QuizItem>)
                    {
                        int j = 10;
                        for (int i = 0; i < item.Choices.Count(); i++)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="AQ_19" data-toggle="AQ_19" value="@j" id="AQ_19_@i">
                                <label class="form-check-label" for="AQ_19_@i"><span style="margin-right: 30px;">@item.Choices[i]</span></label>
                            </div>
                            j = j - 2;
                        }
                        <input asp-for="AQ_19" type="hidden" />
                    }
                </li>
                <li class="list-group-item"><h5 class="font-weight-bold">@quest.QUE_20</h5></li>
                <li class="list-group-item">
                    @foreach (var item in ViewData["answer4"] as IEnumerable<QuizItem>)
                    {
                        int j = 10;
                        for (int i = 0; i < item.Choices.Count(); i++)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="AQ_20" data-toggle="AQ_20" value="@j" id="AQ_20_@i">
                                <label class="form-check-label" for="AQ_20_@i"><span style="margin-right: 20px;">@item.Choices[i]</span></label>
                            </div>
                            j = j - 2;
                        }
                        <input asp-for="AQ_20" type="hidden" />
                    }
                </li>
            }
        </ul>

    </div>
    <!--<div id="alert" class="alert alert-danger fade in" role="alert">-->
    @*<a href="#" class="close" data-dismiss="alert" aria-label="close">×</a>*@
    <!--<strong>모든항목에 체크하세요!</strong>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
    </div>-->


    <div class="toast " role="alert" aria-live="assertive" aria-atomic="true" data-delay="6000" style="position: fixed; top: 1rem; right: 1rem;z-index: 10000;">
        <div class="alert-danger"> 
            <strong class="mr-auto ml-2" >항목체크</strong>
            <small></small>
            @*<button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>*@
        </div>
        <div class="toast-body alert-danger " id="toastbody">
        </div>
    </div>

    <div class="modal-body">
        <div id="response"></div>
    </div>



    <div class="form-group  text-center  col-sm-10 next-btn-wrap">
        <div class="btn-group m-4">
            <button type="button" class="btn btn-primary mx-1" id="btn-next">다음</button>
        </div>
    </div>
</div>
</form>
