@model BlazorAptit.Models.AptitGroupView

@{ ViewData["Title"] = "로그인"; }

<div class="login-page">
    <div class="login-card">
        <a href="/Aptit/MainLogin" class="login-logo-link">
            <img src="~/img/LOGOIMAGE.JPG" alt="옥타그노시스" class="login-logo" />
        </a>

        <form class="login-form" role="form" asp-action="MainLogin">
            @Html.AntiForgeryToken()

            <h2 class="login-heading">기관 로그인</h2>

            @Html.ValidationSummary(true, "", new { @class = "login-alert" })
            @if (ViewBag.Message != null)
            {
                <div class="login-alert">@ViewBag.Message</div>
            }

            <div class="login-field">
                <input asp-for="Group_ID" class="form-control" placeholder="회차코드 입력" value="" autocomplete="username" />
                <span asp-validation-for="Group_ID" class="text-danger"></span>
            </div>
            <div class="login-field">
                <input type="password" asp-for="Password" class="form-control" placeholder="비밀번호 입력" value="" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button class="btn-block btn login-submit" type="submit">로그인</button>
        </form>

        <div class="login-footer">
            <a href="https://aptitude-x.com/" target="_blank">
                <img src="~/img/MAINBOTTOM.JPG" alt="한국진로적성센터" width="260" />
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background: #EBEBEB !important;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.1);
        padding: 36px 32px 28px;
        text-align: center;
    }

    .login-logo-link {
        display: inline-block;
        margin-bottom: 8px;
    }

    .login-logo {
        max-width: 200px;
        height: auto;
    }

    .login-heading {
        font-size: 1.3em;
        font-weight: 800;
        color: #0D4F8A;
        margin: 10px 0 22px;
    }

    .login-alert {
        display: block;
        background: rgba(220,53,69,0.1);
        color: #c0392b;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
        margin-bottom: 16px;
        text-align: left;
    }

    .login-alert:empty {
        display: none;
    }

    .login-field {
        margin-bottom: 16px;
        text-align: left;
    }

    .login-field .form-control {
        width: 100%;
        padding: 10px 12px;
        font-size: 15px;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .login-field .form-control:focus {
        outline: none;
        border-color: #0D4F8A;
        box-shadow: 0 0 0 3px rgba(13,79,138,0.15);
    }

    .login-submit {
        width: 100%;
        margin-top: 8px;
        padding: 11px;
        font-size: 15px;
        font-weight: 700;
        background-color: #0D4F8A;
        border: none;
        border-radius: 8px;
        color: #fff;
        transition: background-color 0.15s ease;
    }

    .login-submit:hover {
        background-color: #0a3d6d;
        color: #fff;
    }

    .login-footer {
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px solid #eee;
    }
</style>
